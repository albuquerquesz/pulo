{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pulo-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-22",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pulo-db",
      "database_id": "ac2e9d19-3c58-4b1a-bfc8-bab090e3bee6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Origens liberadas no CORS e no Better Auth, separadas por vírgula.
    "PULO_CORS_ORIGIN": "http://localhost:3000,https://pulo-web.albqvictor.workers.dev",
    "BETTER_AUTH_URL": "https://pulo-api.albqvictor.workers.dev"
  }
  // Secrets (nunca neste arquivo): BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
  // Em dev, ficam em .dev.vars (veja .dev.vars.example).
}
