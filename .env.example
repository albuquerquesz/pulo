# Copie para .env (ignorado pelo git). Lido pelo Prisma (migrate, studio, seed) via packages/db/prisma.config.ts.
# Conexão DIRETA do Postgres (porta 5432). Nunca use aqui a URL do pooler em modo transação.
# Local (docker compose): usuário, senha e banco "pulo".
DATABASE_URL=postgresql://pulo:pulo@localhost:5432/pulo

# Supabase (produção): troque pela connection string do projeto, com SSL. Veja "Banco de dados" no README.
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
