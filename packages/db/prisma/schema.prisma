// Schema do Pulo (PostgreSQL). Fonte única das tabelas: o SQL vem de `npm run db:migrate`.
//
// Convenções:
// - Tabelas do Better Auth (user, session, account, verification) mantêm os nomes e colunas do Better Auth.
// - Tabelas do domínio: nome snake_case no singular, colunas em camelCase, todas com userId e cascade.
// - DateKey do domínio (dia lógico, 'AAAA-MM-DD') vira `@db.Date`; instantes (ms) viram timestamptz.
// - Os valores dos enums são idênticos às uniões de string de packages/core/domain/types.ts.

// Dois clientes com o mesmo schema: o import interno `#client` (package.json, campo imports) escolhe
// o de workerd quando o bundler usa a condição "workerd" (wrangler) e o de Node nos demais casos
// (testes, seed, Studio). O wasm do workerd não carrega em Node e vice versa.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/node"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
  // join vira o padrão: relações vêm numa query só (JSON agregado + lateral join). Ver docs/banco-de-dados.md.
  previewFeatures     = ["relationJoins"]
}

generator clientWorkerd {
  provider            = "prisma-client"
  output              = "../src/generated/workerd"
  runtime             = "workerd"
  moduleFormat        = "esm"
  importFileExtension = "ts"
  // join vira o padrão: relações vêm numa query só (JSON agregado + lateral join). Ver docs/banco-de-dados.md.
  previewFeatures     = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Better Auth ----------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @db.Timestamptz(3)
  updatedAt     DateTime @db.Timestamptz(3)
  /// Preferências e progresso (ver packages/core/domain/user-metadata.ts). Só a rota /api/me/metadata escreve.
  metadata      Json?    @db.JsonB

  sessions        Session[]
  accounts        Account[]
  routineBlocks   RoutineBlock[]
  habits          Habit[]
  habitLogs       HabitLog[]
  focusSessions   FocusSession[]
  restDays        RestDay[]
  weeklyProposals WeeklyProposal[]
  goals           Goal[]
  islandPurchases IslandPurchase[]
  joiaCredit      JoiaCredit?
  mascotState     MascotState?

  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @db.Timestamptz(3)
  updatedAt             DateTime  @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

// ---------- OAuth (servidor MCP) ----------
// Tabelas do plugin jwt e do @better-auth/oauth-provider (Better Auth 1.7): nomes de campo do plugin, tabelas em snake_case.
// Quem conecta uma IA ao Pulo pelo MCP passa por aqui (ver docs/mcp.md).

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime  @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String    @id
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]  @default([])
  userId                           String?
  user                             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime? @db.Timestamptz(3)
  updatedAt                        DateTime? @db.Timestamptz(3)
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         Json?     @db.JsonB

  resources     OauthClientResource[]
  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@index([userId])
  @@map("oauth_client")
}

model OauthResource {
  id                            String    @id
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?     @db.JsonB
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime? @db.Timestamptz(3)
  updatedAt                     DateTime? @db.Timestamptz(3)
  policyVersion                 Int?      @default(1)
  metadata                      Json?     @db.JsonB

  clients OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?         @db.JsonB
  createdAt  DateTime?     @db.Timestamptz(3)

  @@unique([clientId, resourceId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      String       @id
  token                   String       @unique
  clientId                String
  client                  OauthClient  @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime?    @db.Timestamptz(3)
  createdAt               DateTime?    @db.Timestamptz(3)
  revoked                 DateTime?    @db.Timestamptz(3)
  rotatedAt               DateTime?    @db.Timestamptz(3)
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?    @db.Timestamptz(3)
  authTime                DateTime?    @db.Timestamptz(3)
  confirmation            Json?        @db.JsonB
  scopes                  String[]

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String             @id
  token                   String?            @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime?          @db.Timestamptz(3)
  createdAt               DateTime?          @db.Timestamptz(3)
  revoked                 DateTime?          @db.Timestamptz(3)
  confirmation            Json?              @db.JsonB
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime?   @db.Timestamptz(3)
  updatedAt               DateTime?   @db.Timestamptz(3)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)

  @@map("oauth_client_assertion")
}

// ---------- Domínio ----------

enum PurchaseKind {
  casa
  decoracao
  antiga

  @@map("purchase_kind")
}

enum BlockKind {
  foco
  descanso

  @@map("block_kind")
}

enum FocusSessionState {
  em_andamento
  concluida
  interrompida

  @@map("focus_session_state")
}

enum ProposalState {
  pendente
  aceita
  editada
  negada
  expirada

  @@map("proposal_state")
}

enum GoalState {
  ativa
  concluida

  @@map("goal_state")
}

enum ProposalOrigin {
  ia
  regra

  @@map("proposal_origin")
}

/// Bloco da rotina semanal. weekday: 0 = segunda ... 6 = domingo (CHECK na migração).
model RoutineBlock {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday         Int       @db.SmallInt
  /// Minutos desde 00:00.
  startMinutes    Int       @db.SmallInt
  /// 5 a 120 (CHECK na migração).
  durationMinutes Int       @db.SmallInt
  kind            BlockKind
  title           String?

  focusSessions FocusSession[]

  /// Permite upsert seguro por dono: where { id_userId: { id, userId } }.
  @@unique([id, userId])
  @@index([userId, weekday, startMinutes])
  @@map("routine_block")
}

model Habit {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  /// Dias da semana (0 a 6) em que o hábito vale.
  weekdays Int[]   @db.SmallInt
  active   Boolean @default(true)

  logs HabitLog[]

  @@unique([id, userId])
  @@index([userId, active])
  @@map("habit")
}

/// Hábito feito em um dia. A chave (habitId, date) garante um registro por hábito e dia.
model HabitLog {
  habitId String
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Chave composta com userId: o log só pode apontar para hábito do mesmo dono.
  habit   Habit    @relation(fields: [habitId, userId], references: [id, userId], onDelete: Cascade)
  date    DateTime @db.Date
  doneAt  DateTime @db.Timestamptz(3)

  @@id([habitId, date])
  @@index([userId, date])
  @@map("habit_log")
}

/// Sessão de foco. Uma só `em_andamento` por pessoa (índice único parcial na migração).
model FocusSession {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Se o bloco for apagado, a sessão fica (histórico) sem bloco.
  blockId        String?
  block          RoutineBlock?     @relation(fields: [blockId], references: [id], onDelete: SetNull)
  startedAt      DateTime          @db.Timestamptz(3)
  endedAt        DateTime?         @db.Timestamptz(3)
  plannedMinutes Int               @db.SmallInt
  state          FocusSessionState
  /// Tempo total pausado, em ms.
  pausedMs       Int               @default(0)
  /// Se está pausada agora, quando a pausa começou.
  pausedSince    DateTime?         @db.Timestamptz(3)

  @@unique([id, userId])
  @@index([userId, startedAt])
  @@index([blockId])
  @@map("focus_session")
}

model RestDay {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  @@id([userId, date])
  @@map("rest_day")
}

model WeeklyProposal {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Segunda-feira da semana.
  weekStart   DateTime       @db.Date
  state       ProposalState
  patternText String
  reasonText  String?
  /// ProposalChange[] (validado por zod no mapeador).
  changes     Json           @db.JsonB
  origin      ProposalOrigin
  createdAt   DateTime       @db.Timestamptz(3)
  decidedAt   DateTime?      @db.Timestamptz(3)

  @@unique([id, userId])
  @@unique([userId, weekStart])
  @@map("weekly_proposal")
}

/// Meta de longo prazo. Os marcos moram num Json (GoalMilestone[], validado por zod no mapeador):
/// são poucos, sempre lidos e gravados junto com a meta.
model Goal {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  why         String?
  targetDate  DateTime? @db.Date
  state       GoalState
  milestones  Json      @db.JsonB
  createdAt   DateTime  @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  @@unique([id, userId])
  @@index([userId, state])
  @@map("goal")
}

/// Compra com joias (parte da casa, decoração ou área e enfeite da ilha antiga), uma por item e pessoa.
/// Imutável: só `DELETE /api/data` apaga. O saldo nunca é gravado (ver packages/core/domain/joias.ts).
model IslandPurchase {
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Id do item no catálogo (`HOUSE`, `ROOM_DECOR` ou `ISLAND` em packages/core/config/decisions.ts).
  item      String
  /// `antiga` é a ilha da spec 12: não gasta joias na casa nem no quarto.
  kind      PurchaseKind @default(antiga)
  /// Preço pago, em joias (CHECK >= 0 na migração).
  cost      Int
  createdAt DateTime     @db.Timestamptz(3)

  placement RoomPlacement?

  @@id([userId, item])
  @@map("island_purchase")
}

/// Posição de uma decoração no quarto. Separada da compra porque muda sem nova compra.
model RoomPlacement {
  userId   String
  item     String
  purchase IslandPurchase @relation(fields: [userId, item], references: [userId, item], onDelete: Cascade)
  x        Int            @db.SmallInt
  y        Int            @db.SmallInt
  /// Graus: 0, 90, 180 ou 270 (CHECK na migração).
  rotation Int            @db.SmallInt

  @@id([userId, item])
  @@map("room_placement")
}

/// Joias de ganho histórico concedidas na troca de regra (spec 18). Só a migração grava; `DELETE /api/data` apaga.
model JoiaCredit {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount Int

  @@map("joia_credit")
}

/// Cache do estado do sapo (derivado). Uma linha por pessoa.
model MascotState {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1 a 4 (CHECK na migração).
  phase     Int      @db.SmallInt
  careDays  Int
  updatedAt DateTime @db.Timestamptz(3)

  @@map("mascot_state")
}
