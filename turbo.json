{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": [
    "VITE_*",
    "PULO_*",
    "PORT",
    "DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^generate",
        "generate"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "outputs": [],
      "dependsOn": [
        "^generate",
        "generate"
      ]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": [
        "^generate",
        "generate"
      ]
    },
    "lint": {
      "outputs": [],
      "dependsOn": [
        "^generate",
        "generate"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": [
        "typecheck",
        "test",
        "^generate"
      ],
      "cache": false,
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ]
    },
    "generate": {
      "outputs": [
        "src/generated/**"
      ],
      "inputs": [
        "prisma/schema.prisma",
        "prisma.config.ts"
      ]
    }
  }
}
